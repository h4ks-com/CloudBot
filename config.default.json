{
    "connections": [
        {
            "name": "esper",
            "type": "irc",
            "auto_rejoin": false,
            "invite_join": true,
            "join_throttle": 0.4,
            "require_registered_channels": false,
            "connection": {
                "server": "irc.esper.net",
                "port": 6667,
                "ssl": false,
                "ignore_cert": true,
                "password": "",
                "timeout": 300,
                "client_cert": "cloudbot.pem",
                "bind_addr": "",
                "bind_port": 0
            },
            "ping_settings": {
                "interval": 60,
                "warn": 120,
                "timeout": 300
            },
            "user_agent": "CloudBot/3.0 - CloudBot Refresh <https://github.com/chat-apropo/CloudBot>",
            "reply_ping": true,
            "nick": "MyCloudBot",
            "user": "cloudbot",
            "realname": "CloudBot - https://git.io/CloudBot",
            "avoid_notices": false,
            "channels": [
                "#cloudbot",
                "#cloudbot2"
            ],
            "mode": null,
            "oper_user": null,
            "oper_pw": null,
            "log_channel": "#MyAdminChannel",
            "disabled_commands": [],
            "acls": {},
            "sasl": {
                "enabled": false,
                "mechanism": "PLAIN",
                "user": "",
                "pass": ""
            },
            "nickserv": {
                "enabled": false,
                "nickserv_password": "",
                "nickserv_user": "",
                "nickserv_name": "nickserv",
                "nickserv_command": "IDENTIFY"
            },
            "strip_newlines": true,
            "max_line_length": 510,
            "encoding": "utf-8",
            "encoding_errors": "replace",
            "strip_cmd_chars": "!.@;$",
            "ratelimit": {
                "max_tokens": 17.5,
                "restore_rate": 2.5,
                "message_cost": 5,
                "strict": true
            },
            "permissions": {
                "admins": {
                    "perms": [
                        "addfactoid",
                        "delfactoid",
                        "ignore",
                        "botcontrol",
                        "plpaste",
                        "permissions_users",
                        "op"
                    ],
                    "users": [
                        "examplea!user@example.com",
                        "exampleb!user@example.com"
                    ]
                },
                "moderators": {
                    "perms": [
                        "addfactoid",
                        "delfactoid",
                        "ignore"
                    ],
                    "users": [
                        "examplec!user@example.com"
                    ]
                }
            },
            "plugins": {},
            "command_prefix": "."
        }
    ],
    "plugins": {
        "duckhunt": {
            "minimum_messages": 10,
            "minimum_users": 5
        },
        "speech": {
            "api": "http://localhost:5000"
        },
        "worldguess": {
            "api_url": "http://localhost:8000"
        },
        "suno": {
            "api_url": "",
            "api_key": ""
        },
        "aimedia": {
            "api_url": "",
            "api_key": ""
        },
        "strudel": {
            "api_url": "",
            "api_key": ""
        },
        "hyperframes": {
            "api_url": "",
            "api_key": ""
        },
        "radio": {
            "api_url": "http://localhost:8383",
            "api_token": "",
            "connection": "esper",
            "channels": {},
            "n8n_slop": {
                "webhook_url": "https://n8n.t3ks.com/webhook/slopradio",
                "header_name": "X-Custom-Auth",
                "header_value": ""
            }
        },
        "comfyui_workflows": {
            "api_url": "https://comfy.example.com",
            "basic_auth": {
                "username": "",
                "password": ""
            },
            "poll_interval": 2,
            "max_wait_time": 120,
            "workflows": {
                "audio_stable_audio_example": {
                    "text_input_node": "CLIP Text Encode (Prompt)",
                    "output_node": "SaveAudio",
                    "output_type": "output",
                    "file_extension": "flac"
                }
            }
        },
        "beapin": {
            "api_url": "http://localhost:8383",
            "admin_api_key": "",
            "bot_username": "cloudbot"
        },
        "openrouter": {
            "default_model": "openai/gpt-3.5-turbo",
            "max_history_messages": 50,
            "timeout": 30
        },
        "agent": {
            "enabled": true,
            "backend": "z_ai",
            "fallback_backend": "openrouter",
            "backends": {
                "z_ai": {
                    "base_url": "https://api.z.ai/api/coding/paas/v4",
                    "model": "glm-5",
                    "api_key_config_path": "z_ai"
                },
                "openrouter": {
                    "base_url": "https://openrouter.ai/api/v1",
                    "model": "z-ai/glm-4.5-air:free",
                    "api_key_config_path": "openrouter"
                },
                "ollama": {
                    "base_url": "https://ollama.t3ks.com/v1",
                    "model": "gemma4:e4b",
                    "api_key_config_path": "plugins.ollama.api_key",
                    "auth_header": "x-api-key"
                }
            },
            "big_brain": {
                "enabled": false,
                "model": "glm-5.1",
                "base_url": "https://api.z.ai/api/coding/paas/v4",
                "api_key_config_path": "z_ai"
            },
            "vision": {
                "base_url": "https://api.z.ai/api/paas/v4",
                "model": "glm-4.6v-flash",
                "api_key_config_path": "z_ai"
            },
            "context7": {
                "api_key_config_path": ""
            },
            "github_mcp": {
                "enabled": true,
                "url": "https://github-mcp.t3ks.com/mcp",
                "api_key_config_path": "github_mcp_bot",
                "github_token_config_path": "github",
                "self_repo": "h4ks-com/CloudBot"
            },
            "mcp_servers": {
                "kinesthesia": {
                    "enabled": true,
                    "url": "https://kinesthesia.h4ks.com/api/mcp",
                    "timeout_s": 30
                },
                "ytdl": {
                    "enabled": true,
                    "url": "https://ytdl.t3ks.com/mcp/",
                    "api_key_config_path": "ytdl_mcp",
                    "api_key_header": "x-api-key",
                    "timeout_s": 900
                },
                "midifier": {
                    "enabled": true,
                    "url": "https://midifier.t3ks.com/mcp/",
                    "bearer_token_config_path": "midifier_mcp",
                    "timeout_s": 60
                }
            },
            "max_turns": 40,
            "timeout_s": 2400,
            "reply_max_chars": 420,
            "enabled_channels": [],
            "include": [],
            "exclude": [
                "quit",
                "restart",
                "part",
                "kick",
                "ban",
                "op",
                "deop",
                "ignore",
                "unignore",
                "chainallow",
                "join",
                "nick",
                "mode",
                "gpt",
                "gemini",
                "ollama",
                "huggingface",
                "openrouter",
                "chatbot",
                "pollinations",
                "chain",
                "ask",
                "agent",
                "prove",
                "pv",
                "code",
                "cd",
                "strudel"
            ]
        },
        "sandbox_agent": {
            "sandbox_url": "https://sandbox.t3ks.com/mcp",
            "sandbox_api_key": "",
            "prove_max_turns": 20,
            "code_max_turns": 10,
            "timeout_s": 300
        },
        "strudel_agent": {
            "max_turns": 24,
            "timeout_s": 420
        },
        "hyperframes_agent": {
            "max_turns": 40,
            "timeout_s": 600,
            "model": "glm-5.2",
            "disable_thinking": true
        }
    },
    "browserless": {
        "api_url": "https://chrome.browserless.io",
